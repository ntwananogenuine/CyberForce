<Window x:Class="POE.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:POE"
        mc:Ignorable="d"
        Title="CYBERFORCE"
        Loaded="Window_Loaded"
        Height="620"
        Width="980"
        Background="#0B1F33">

    <Grid>

        <!-- ══════════════════════════════════════════════════════════════════
             HOME GRID
        ══════════════════════════════════════════════════════════════════ -->
        <Grid x:Name="home_grid" Visibility="Hidden" Background="#0B1F33">
            <Border Background="#102A43" CornerRadius="20"
                    Width="600" Height="450" Padding="20"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel HorizontalAlignment="Center">
                    <Image Source="/logo.png" Height="180" Width="250" Margin="0,0,0,20"/>
                    <TextBlock Text="CYBERFORCE AI" FontSize="28" FontWeight="Bold"
                               Foreground="Cyan" HorizontalAlignment="Center" Margin="0,10"/>
                    <TextBlock Text="Welcome to CYBERFORCE, The Cybersecurity AI ChatBot."
                               FontSize="16" Foreground="Cyan" Width="450"
                               TextAlignment="Center" TextWrapping="Wrap" Margin="0,20"/>
                    <Button Content="START AI" Height="50" Width="250" FontSize="18"
                            FontWeight="Bold" Background="Cyan" Foreground="Black"
                            BorderThickness="0" Cursor="Hand" Click="proceed" Margin="0,30,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ══════════════════════════════════════════════════════════════════
             USERNAME GRID
        ══════════════════════════════════════════════════════════════════ -->
        <Grid x:Name="username_grid" Visibility="Visible" Background="#081624">
            <Border Background="#102A43" CornerRadius="20"
                    Width="500" Height="400" Padding="20"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel HorizontalAlignment="Center">
                    <Image Source="/logo.png" Height="150" Width="220" Margin="0,0,0,20"/>
                    <TextBlock Text="Enter Your Username" FontSize="24" FontWeight="Bold"
                               Foreground="Cyan" HorizontalAlignment="Center" Margin="0,10"/>
                    <TextBlock Text="Please enter your username to continue."
                               Foreground="White" FontSize="14"
                               TextAlignment="Center" Margin="0,10"/>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center" Margin="0,30,0,0">
                        <TextBox x:Name="usernames_input" Height="45" Width="220"
                                 FontSize="16" HorizontalContentAlignment="Center"
                                 VerticalContentAlignment="Center" Margin="0,0,10,0"/>
                        <Button Content="LOGIN" Height="45" Width="80" FontSize="16"
                                FontWeight="Bold" Background="Cyan" Foreground="Black"
                                BorderThickness="0" Cursor="Hand" Click="submit_name"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ══════════════════════════════════════════════════════════════════
             MAIN APP GRID  (header + sidebar + content area)
        ══════════════════════════════════════════════════════════════════ -->
        <Grid x:Name="chat_grid" Visibility="Hidden" Background="#081624">
            <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
                <!-- header -->
                <RowDefinition Height="*"/>
                <!-- body   -->
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Border Grid.Row="0" Background="#102A43" Padding="12">
                <DockPanel>
                    <Image Source="/logo.png" Width="50" Height="50" DockPanel.Dock="Left"/>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="CYBERFORCE AI" FontSize="22" FontWeight="Bold" Foreground="Cyan"/>
                        <TextBlock Text="Cybersecurity Awareness ChatBot" FontSize="12" Foreground="Cyan"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- BODY: sidebar + content panels -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <!-- sidebar -->
                    <ColumnDefinition Width="*"/>
                    <!-- content -->
                </Grid.ColumnDefinitions>

                <!-- ── SIDEBAR ─────────────────────────────────────────── -->
                <StackPanel Grid.Column="0" Background="#0B1F33" Margin="0">
                    <Button x:Name="btn_chat"  Content="💬 Chat"   Height="50" Margin="6,10,6,4"
                            FontSize="14" FontWeight="Bold" Background="Cyan"
                            Foreground="Black" BorderThickness="0" Cursor="Hand"
                            Click="Nav_Chat"/>
                    <Button x:Name="btn_tasks" Content="✅ Tasks"  Height="50" Margin="6,4,6,4"
                            FontSize="14" Background="#1A3A5C"
                            Foreground="White" BorderThickness="0" Cursor="Hand"
                            Click="Nav_Tasks"/>
                    <Button x:Name="btn_quiz"  Content="🎮 Quiz"   Height="50" Margin="6,4,6,4"
                            FontSize="14" Background="#1A3A5C"
                            Foreground="White" BorderThickness="0" Cursor="Hand"
                            Click="Nav_Quiz"/>
                    <Button x:Name="btn_log"   Content="📋 Log"    Height="50" Margin="6,4,6,4"
                            FontSize="14" Background="#1A3A5C"
                            Foreground="White" BorderThickness="0" Cursor="Hand"
                            Click="Nav_Log"/>
                </StackPanel>

                <!-- ══════════════════════════════════════════════════════
                     CHAT PANEL
                ══════════════════════════════════════════════════════ -->
                <Grid x:Name="panel_chat" Grid.Column="1" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="80"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Margin="10,10,10,5" CornerRadius="12" Background="#102A43">
                        <ListView x:Name="chats" Background="Transparent"
                                  BorderThickness="0" Foreground="White"
                                  FontSize="14" Padding="8"/>
                    </Border>

                    <Grid Grid.Row="1" Margin="10,0,10,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="question" Grid.Column="0" Height="48"
                                 FontSize="15" VerticalContentAlignment="Center"
                                 Margin="0,0,8,0"/>
                        <Button Grid.Column="1" Content="SEND" Height="48" FontSize="16"
                                FontWeight="Bold" Background="Cyan" Foreground="Black"
                                BorderThickness="0" Cursor="Hand" Click="send"/>
                    </Grid>
                </Grid>

                <!-- ══════════════════════════════════════════════════════
                     TASK PANEL
                ══════════════════════════════════════════════════════ -->
                <Grid x:Name="panel_tasks" Grid.Column="1" Visibility="Hidden">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- add-task form  -->
                        <RowDefinition Height="*"/>
                        <!-- task list       -->
                        <RowDefinition Height="Auto"/>
                        <!-- action buttons  -->
                    </Grid.RowDefinitions>

                    <!-- Add-task form -->
                    <Border Grid.Row="0" Background="#102A43" CornerRadius="12" Margin="10,10,10,5" Padding="12">
                        <StackPanel>
                            <TextBlock Text="Add New Cybersecurity Task" FontSize="16"
                                       FontWeight="Bold" Foreground="Cyan" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="task_title" Grid.Column="0" Height="36"
                                         FontSize="13" Margin="0,0,6,0"
                                         VerticalContentAlignment="Center"
                                         Tag="Title"/>
                                <TextBox x:Name="task_desc" Grid.Column="1" Height="36"
                                         FontSize="13" Margin="0,0,6,0"
                                         VerticalContentAlignment="Center"
                                         Tag="Description"/>
                                <TextBox x:Name="task_reminder" Grid.Column="2" Height="36"
                                         FontSize="13" Margin="0,0,6,0"
                                         VerticalContentAlignment="Center"
                                         Tag="Reminder (optional)"/>
                                <Button Grid.Column="3" Content="ADD" Height="36"
                                        FontSize="14" FontWeight="Bold"
                                        Background="Cyan" Foreground="Black"
                                        BorderThickness="0" Cursor="Hand"
                                        Click="AddTask_Click"/>
                            </Grid>
                            <!-- Placeholder hint labels -->
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock Text="↑ Title" Foreground="#88AACC" FontSize="11" Width="175" Margin="2,0"/>
                                <TextBlock Text="↑ Description" Foreground="#88AACC" FontSize="11" Width="175" Margin="2,0"/>
                                <TextBlock Text="↑ Reminder (e.g. 3 days)" Foreground="#88AACC" FontSize="11" Width="175" Margin="2,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Task list -->
                    <Border Grid.Row="1" Background="#102A43" CornerRadius="12" Margin="10,0,10,5">
                        <ListView x:Name="task_list" Background="Transparent"
                                  BorderThickness="0" Foreground="White"
                                  FontSize="13" Padding="8"
                                  SelectionMode="Single"/>
                    </Border>

                    <!-- Action buttons -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="10,0,10,10">
                        <Button Content="✔ Mark Complete" Height="38" Width="160"
                                FontSize="13" Background="#00897B" Foreground="White"
                                BorderThickness="0" Cursor="Hand" Margin="0,0,8,0"
                                Click="CompleteTask_Click"/>
                        <Button Content="🗑 Delete" Height="38" Width="120"
                                FontSize="13" Background="#C62828" Foreground="White"
                                BorderThickness="0" Cursor="Hand"
                                Click="DeleteTask_Click"/>
                        <Button Content="🔄 Refresh" Height="38" Width="100"
                                FontSize="13" Background="#1A3A5C" Foreground="White"
                                BorderThickness="0" Cursor="Hand" Margin="8,0,0,0"
                                Click="RefreshTasks_Click"/>
                    </StackPanel>
                </Grid>

                <!-- ══════════════════════════════════════════════════════
                     QUIZ PANEL
                ══════════════════════════════════════════════════════ -->
                <Grid x:Name="panel_quiz" Grid.Column="1" Visibility="Hidden">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="80"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Margin="10,10,10,5" CornerRadius="12" Background="#102A43">
                        <ListView x:Name="quiz_log" Background="Transparent"
                                  BorderThickness="0" Foreground="White"
                                  FontSize="14" Padding="8"/>
                    </Border>

                    <Grid Grid.Row="1" Margin="10,0,10,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="130"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="quiz_answer" Grid.Column="0" Height="48"
                                 FontSize="15" VerticalContentAlignment="Center"
                                 Margin="0,0,8,0"/>
                        <Button Grid.Column="1" Content="ANSWER" Height="48"
                                FontSize="14" FontWeight="Bold"
                                Background="Cyan" Foreground="Black"
                                BorderThickness="0" Cursor="Hand" Click="QuizAnswer_Click"
                                Margin="0,0,8,0"/>
                        <Button Grid.Column="2" Content="START QUIZ" Height="48"
                                FontSize="13" FontWeight="Bold"
                                Background="#00897B" Foreground="White"
                                BorderThickness="0" Cursor="Hand" Click="StartQuiz_Click"/>
                    </Grid>
                </Grid>

                <!--ACTIVITY LOG PANEL -->
                <Grid x:Name="panel_log" Grid.Column="1" Visibility="Hidden">
                    <Border Margin="10" CornerRadius="12" Background="#102A43" Padding="14">
                        <StackPanel>
                            <TextBlock Text="📋 Activity Log (last 10 actions)"
                                       FontSize="16" FontWeight="Bold"
                                       Foreground="Cyan" Margin="0,0,0,12"/>
                            <ListView x:Name="log_list" Background="Transparent"
                                      BorderThickness="0" Foreground="White"
                                      FontSize="13" Height="430"/>
                            <Button Content="🔄 Refresh Log" Height="38" Width="140"
                                    FontSize="13" Background="#1A3A5C" Foreground="White"
                                    BorderThickness="0" Cursor="Hand" Margin="0,12,0,0"
                                    Click="RefreshLog_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>

            </Grid>
        </Grid>

    </Grid>
</Window>