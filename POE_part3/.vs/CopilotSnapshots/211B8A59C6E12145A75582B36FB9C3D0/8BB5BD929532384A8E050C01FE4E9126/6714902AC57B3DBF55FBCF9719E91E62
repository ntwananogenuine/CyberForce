<Window x:Class="demo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:demo"
        mc:Ignorable="d"
        Title="CYBERFORCE"
        Height="600"
        Width="900"
        Background="#0B1F33">

    <Grid>

        <!-- ========================================================= -->
        <!-- HOME GRID -->
        <!-- ========================================================= -->

        <Grid x:Name="home_grid"
              Visibility="Visible"
              Background="#0B1F33">

            <Border Background="#102A43"
                    CornerRadius="20"
                    Width="600"
                    Height="450"
                    Padding="20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                <StackPanel HorizontalAlignment="Center">

                    <!-- Logo -->
                    <Image Source="/logo.png"
                           Height="180"
                           Width="250"
                           Margin="0,0,0,20"/>

                    <!-- Title -->
                    <TextBlock Text="CYBERFORCE SECURITY AI"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="Cyan"
                               HorizontalAlignment="Center"
                               Margin="0,10"/>

                    <!-- Welcome -->
                    <TextBlock
                        Text="Welcome to CYBERFORCE. Your personal cybersecurity assistant."
                        FontSize="16"
                        Foreground="White"
                        Width="450"
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        Margin="0,20"/>

                    <!-- Start Button -->
                    <Button Content="START AI"
                            Height="50"
                            Width="250"
                            FontSize="18"
                            FontWeight="Bold"
                            Background="Cyan"
                            Foreground="Black"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="proceed"
                            Margin="0,30,0,0"/>

                </StackPanel>

            </Border>

        </Grid>

        <!-- ========================================================= -->
        <!-- USERNAME GRID -->
        <!-- ========================================================= -->

        <Grid x:Name="username_grid"
              Visibility="Hidden"
              Background="#081624">

            <Border Background="#102A43"
                    CornerRadius="20"
                    Width="500"
                    Height="400"
                    Padding="20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                <StackPanel HorizontalAlignment="Center">

                    <!-- Logo -->
                    <Image Source="/logo.png"
                           Height="150"
                           Width="220"
                           Margin="0,0,0,20"/>

                    <!-- Heading -->
                    <TextBlock
                        Text="Enter Your Username"
                        FontSize="24"
                        FontWeight="Bold"
                        Foreground="Cyan"
                        HorizontalAlignment="Center"
                        Margin="0,10"/>

                    <!-- Username TextBox -->
                    <TextBox
                        x:Name="usernames_input"
                        KeyDown="UsernamesInput_KeyDown"
                        Height="45"
                        Width="300"
                        FontSize="16"
                        Margin="0,30,0,10"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"/>

                    <!-- Hint -->
                    <TextBlock
                        Text="Please enter your username to continue."
                        Foreground="White"
                        FontSize="14"
                        TextAlignment="Center"
                        Margin="0,10"/>

                    <!-- Submit Button -->
                    <Button
                        Content="SUBMIT"
                        Height="45"
                        Width="300"
                        FontSize="16"
                        FontWeight="Bold"
                        IsDefault="True"
                        Background="Cyan"
                        Foreground="Black"
                        BorderThickness="0"
                        Cursor="Hand"
                        Margin="0,30,0,0"
                        Click="submit_name"/>

                </StackPanel>

            </Border>

        </Grid>

        <!-- ========================================================= -->
        <!-- CHAT GRID -->
        <!-- ========================================================= -->

        <Grid x:Name="chat_grid"
              Visibility="Hidden"
              Background="#081624">

            <Grid.RowDefinitions>
                <RowDefinition Height="80"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="90"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Border Grid.Row="0"
                    Background="#102A43"
                    Padding="15">

                <DockPanel>

                    <Image Source="/logo.png"
                           Width="60"
                           Height="60"
                           DockPanel.Dock="Left"/>

                    <StackPanel Margin="15,0,0,0">

                        <TextBlock Text="CYBERFORCE AI"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="Cyan"/>

                        <TextBlock Text="Cybersecurity Awareness Assistant"
                                   FontSize="14"
                                   Foreground="White"/>

                    </StackPanel>

                </DockPanel>

            </Border>

            <!-- CHAT AREA -->
            <Border Grid.Row="1"
                    Margin="15"
                    CornerRadius="15"
                    Background="#102A43">

                <ListView x:Name="chats"
                          Background="Transparent"
                          BorderThickness="0"
                          Foreground="White"
                          FontSize="14"
                          Padding="10"/>

            </Border>

            <!-- INPUT AREA -->
            <Grid Grid.Row="2"
                  Margin="15">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="160"/>
                </Grid.ColumnDefinitions>

                <!-- Question Box -->
                <TextBox
                    x:Name="question"
                    Grid.Column="0"
                    Height="50"
                    FontSize="16"
                    VerticalContentAlignment="Center"
                    Margin="0,0,10,0"/>

                <!-- Send Button -->
                <Button
                    Grid.Column="1"
                    Content="SEND"
                    Height="50"
                    FontSize="18"
                    FontWeight="Bold"
                    Background="Cyan"
                    Foreground="Black"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="send"/>

            </Grid>

        </Grid>

    </Grid>

</Window>